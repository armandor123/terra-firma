{
  "openapi": "3.1.0",
  "info": {
    "title": "Terra-Firma — Dados e Inputs",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/context": {
      "post": {
        "summary": "Context",
        "operationId": "context_v1_context_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Location"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/weather": {
      "post": {
        "summary": "Only Weather",
        "operationId": "only_weather_v1_weather_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Location"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hotspots": {
      "post": {
        "summary": "Only Hotspots",
        "operationId": "only_hotspots_v1_hotspots_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Location"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Location"
          },
          "weather": {
            "$ref": "#/components/schemas/Envelope"
          },
          "hotspots": {
            "$ref": "#/components/schemas/Envelope"
          },
          "risk": {
            "additionalProperties": true,
            "type": "object",
            "title": "Risk"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "weather",
          "hotspots",
          "risk"
        ],
        "title": "Context"
      },
      "Envelope": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable",
              "stale"
            ],
            "title": "Status"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Weather"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/Hotspot"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "simulated",
          "status",
          "observed_at",
          "fetched_at",
          "data"
        ],
        "title": "Envelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hotspot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "nominal",
              "high"
            ],
            "title": "Confidence"
          },
          "frp_mw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frp Mw"
          },
          "distance_km": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "latitude",
          "longitude",
          "observed_at",
          "confidence",
          "distance_km"
        ],
        "title": "Hotspot"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "radius_km": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Radius Km",
            "default": 10
          },
          "days": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Weather": {
        "properties": {
          "temperature_c": {
            "type": "number",
            "maximum": 70.0,
            "minimum": -100.0,
            "title": "Temperature C"
          },
          "humidity_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Humidity Pct"
          },
          "wind_kmh": {
            "type": "number",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Wind Kmh"
          },
          "wind_direction_deg": {
            "type": "number",
            "maximum": 360.0,
            "minimum": 0.0,
            "title": "Wind Direction Deg"
          },
          "precipitation_mm": {
            "type": "number",
            "minimum": 0.0,
            "title": "Precipitation Mm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "temperature_c",
          "humidity_pct",
          "wind_kmh",
          "wind_direction_deg",
          "precipitation_mm"
        ],
        "title": "Weather"
      }
    }
  }
}