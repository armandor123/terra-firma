# Gere valores seguros usando python -c "import secrets; print(secrets.token_urlsafe(32))"
# A senha do Compose deve usar caracteres URL-safe (como o comando acima).
POSTGRES_USER=terra_firma
POSTGRES_DB=terra_firma
POSTGRES_PASSWORD=
# Identidade DML distinta; não reutilize a senha de migração.
POSTGRES_APP_USER=terra_firma_app
POSTGRES_APP_PASSWORD=
DATA_API_KEY=
DATA_MODE=demo
FIRMS_MAP_KEY=
# Independente de DATA_MODE. Gemini exige chave e modelo compatível, definidos no servidor.
VISION_MODE=simulated
GEMINI_API_KEY=
GEMINI_MODEL=
# Janela retroativa em horas (1–96); raio em km (1–50). Não são índices de risco.
EVIDENCE_RADIUS_KM=10
EVIDENCE_WINDOW_HOURS=24
# Para testar no celular na mesma rede: BACKEND_BIND=0.0.0.0 (somente em rede confiável)
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
DATA_PORT=8001
WEB_BIND=127.0.0.1
WEB_PORT=8080
