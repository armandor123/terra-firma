  "components": {
    "schemas": {
      "Body_add_incident_v1_incidents_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "maxLength": 10000,
            "title": "Metadata"
          },
          "photo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Photo"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "photo"
        ],
        "title": "Body_add_incident_v1_incidents_post"
      },
      "EnvironmentSnapshot": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "unavailable",
              "no_location"
            ],
            "title": "Status"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "query": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EnvironmentalQuery"
              },
              {
                "type": "null"
              }
            ]
          },
          "weather": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceEnvelope_Weather_"
              },
              {
                "type": "null"
              }
            ]
          },
          "hotspots": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceEnvelope_list_Hotspot__"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "collected_at",
          "query"
        ],
        "title": "EnvironmentSnapshot"
      },
      "EnvironmentalQuery": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "radius_km": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Radius Km"
          },
          "days": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "radius_km",
          "days"
        ],
        "title": "EnvironmentalQuery"
      },
      "Evidence": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "method": {
            "type": "string",
            "const": "spatial-temporal-context-v1",
            "title": "Method",
            "default": "spatial-temporal-context-v1"
          },
          "reference_at": {
            "type": "string",
            "format": "date-time",
            "title": "Reference At"
          },
          "reference_kind": {
            "type": "string",
            "const": "server_received_at",
            "title": "Reference Kind",
            "default": "server_received_at"
          },
          "parameters": {
            "$ref": "#/components/schemas/EvidenceSettings"
          },
          "visual_classification": {
            "type": "string",
            "enum": [
              "fire_suspected",
              "smoke_suspected",
              "dry_vegetation",
              "burned_area",
              "no_signs",
              "inconclusive"
            ],
            "title": "Visual Classification"
          },
          "visual_simulated": {
            "type": "boolean",
            "title": "Visual Simulated"
          },
          "simulated": {
            "type": "boolean",
            "title": "Simulated"
          },
          "consistency": {
            "type": "string",
            "enum": [
              "consistent",
              "no_nearby_hotspot",
              "unavailable"
            ],
            "title": "Consistency"
          },
          "nearby_hotspots": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/HotspotMatch"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nearby Hotspots"
          },
          "excluded_hotspots_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Excluded Hotspots Count"
          },
          "weather": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceEnvelope_Weather_"
              },
              {
                "type": "null"
              }
            ]
          },
          "weather_time_difference_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weather Time Difference Seconds"
          },
          "human_review_required": {
            "type": "boolean",
            "const": true,
            "title": "Human Review Required",
            "default": true
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reference_at",
          "parameters",
          "visual_classification",
          "visual_simulated",
          "simulated",
          "consistency",
          "nearby_hotspots",
          "excluded_hotspots_count",
          "weather",
          "weather_time_difference_seconds",
          "warnings"
        ],
        "title": "Evidence"
      },
      "EvidenceSettings": {
        "properties": {
          "radius_km": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Radius Km",
            "default": 10
          },
          "window_hours": {
            "type": "number",
            "maximum": 96.0,
            "minimum": 1.0,
            "title": "Window Hours",
            "default": 24
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EvidenceSettings"
      },
      "Farmer": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{3,80}$",
            "title": "Username"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "username"
        ],
        "title": "Farmer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hotspot": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "nominal",
              "high"
            ],
            "title": "Confidence"
          },
          "frp_mw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frp Mw"
          },
          "distance_km": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance Km"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "latitude",
          "longitude",
          "observed_at",
          "confidence",
          "distance_km"
        ],
        "title": "Hotspot"
      },
      "HotspotMatch": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
