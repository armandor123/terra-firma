  "components": {
    "schemas": {
      "Body_add_incident_v1_incidents_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "maxLength": 10000,
            "title": "Metadata"
          },
          "photo": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Photo"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "photo"
        ],
        "title": "Body_add_incident_v1_incidents_post"
      },
      "Farmer": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{3,80}$",
            "title": "Username"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "username"
        ],
        "title": "Farmer"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Password": {
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Old Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old_password",
          "new_password"
        ],
        "title": "Password"
      },
      "Property": {
        "properties": {
          "farmer_id": {
            "type": "string",
            "title": "Farmer Id"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "title": "Name",
            "default": ""
          },
          "municipality": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Municipality"
          },
          "state": {
            "type": "string",
            "pattern": "^(AC|AL|AP|AM|BA|CE|DF|ES|GO|MA|MT|MS|MG|PA|PB|PR|PE|PI|RJ|RN|RS|RO|RR|SC|SP|SE|TO)$",
            "title": "State"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "area_ha": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Area Ha"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "farmer_id",
          "municipality",
          "state",
          "latitude",
          "longitude"
        ],
        "title": "Property"
      },
      "Refresh": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "Refresh"
      },
      "Review": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "under_review",
              "verified",
              "rejected",
              "escalated"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "notes"
        ],
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}